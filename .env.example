# --- Sağlayıcılar ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Geliştirmede mock sunucuya yönlendirmek için. Üretimde boş bırakılır.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GEMINI_BASE_URL=

# --- Veritabanı ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Hız limiti ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Yönetici paneli (/admin) ---
# Paneli açan jeton. Uzun ve rastgele olmalı.
ADMIN_TOKEN=

# --- Oturumlar ---
# Portal ve panel oturum çerezlerini imzalayan anahtar.
# Değişirse herkes yeniden giriş yapar.
SESSION_SECRET=

# --- Zamanlanmış fiyat denetimi ---
# Vercel Cron /admin/api/cron/prices ucunu bu başlıkla çağırıyor.
# Dolu olmazsa uç yalnızca yönetici jetonuyla tetiklenebilir.
CRON_SECRET=

# --- Yerel test anahtarları (isteğe bağlı) ---
# Portal ve ağ geçidi denemelerinde kullanılan müşteri anahtarları.
TEST_PROXY_KEY=
DEMO_LIMITED_KEY=

# --- Sahte sağlayıcı ---
# Gerçek sağlayıcı anahtarları yokken /mock yolunu açar.
# Üretimde BASE_URL değişkenleri bu adrese yönlendirilir.
ENABLE_MOCK_PROVIDERS=true

# Bütçe dönemleri hangi saat dilimine göre dönsün.
# Günlük sayaç bu dilimde gece yarısı, aylık sayaç ayın 1'inde sıfırlanır.
BUDGET_TIMEZONE=Europe/Istanbul
