# =============================================================================
# AI Proxy Gateway — Environment Configuration
# Copy this file to .env and fill in the values matching your infrastructure.
# =============================================================================

# --- 1. Server Runtime (Node.js / Docker / Self-Hosted) ---
PORT=3000
HOST=127.0.0.1

# --- 2. Database Layer ---
# Standard PostgreSQL connection string used by Drizzle ORM & `npm run db:migrate`.
# Works with local PostgreSQL, Docker, Neon, AWS RDS, Railway, or Supabase Pooler.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_proxy_gateway

# Optional: Required only if using the built-in Supabase-backed /admin & /portal web UIs.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- 3. AI Provider Keys (Direct Mode — used when VAULT_API_URL is unset) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: Custom OpenAI/Anthropic/Gemini-compatible base URLs
# (e.g., Ollama, vLLM, LiteLLM, Azure OpenAI, or `http://127.0.0.1:4000` for `npm run mock`)
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GEMINI_BASE_URL=

# --- 4. Centralized Vault Server (Optional — Production Secret Isolation) ---
# When configured, provider keys are fetched from Vault and SWR-cached in Redis.
VAULT_API_URL=
VAULT_ACCESS_TOKEN=

# --- 5. Cache, Rate Limiting & Session Buffering (Optional — Fail-Open) ---
# Compatible with Upstash Redis REST API or serverless-redis-http (SRH) for local Redis.
# If omitted, the gateway runs in fail-open mode without Redis (not recommended for production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- 6. Admin Console, Portal & Security Secrets ---
# IMPORTANT: Generate strong random secrets in production (e.g., `openssl rand -hex 32`).
ADMIN_TOKEN=
SESSION_SECRET=
ENABLE_PORTAL=false
BUDGET_TIMEZONE=Europe/Istanbul
CRON_SECRET=

# --- 7. Local Development & Testing (Optional) ---
ENABLE_MOCK_PROVIDERS=false
TEST_PROXY_KEY=
DEMO_LIMITED_KEY=
