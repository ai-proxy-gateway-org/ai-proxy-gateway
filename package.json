{
  "name": "ai-proxy-gateway",
  "version": "1.0.0",
  "description": "High-performance, modular AI API Gateway with multi-provider routing, cost tracking, rate limiting, and pluggable storage.",
  "main": "src/server.ts",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "key:create": "tsx scripts/create-key.ts",
    "mock": "tsx watch mock-server/index.ts",
    "mock-vault": "tsx watch mock-vault/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-proxy-gateway-org/ai-proxy-gateway.git"
  },
  "keywords": [
    "ai",
    "llm",
    "proxy",
    "gateway",
    "openai",
    "anthropic",
    "gemini",
    "hono",
    "edge"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ai-proxy-gateway-org/ai-proxy-gateway/issues"
  },
  "homepage": "https://github.com/ai-proxy-gateway-org/ai-proxy-gateway#readme",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "supabase": "^2.114.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@supabase/supabase-js": "^2.112.3",
    "@upstash/redis": "^1.38.2",
    "@vercel/functions": "^3.9.5",
    "@vercel/node": "^5.10.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.11",
    "postgres": "^3.4.9",
    "tsx": "^4.23.12"
  }
}
